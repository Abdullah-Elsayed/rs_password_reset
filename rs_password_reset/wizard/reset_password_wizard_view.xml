<odoo>
    <record id="view_reset_password_wizard" model="ir.ui.view">
        <field name="name">reset.password.wizard.form</field>
        <field name="model">reset.password.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Reset Password Link">
                <group>
                    <field name="user_id"/>
                    <field name="reset_link" readonly="1" widget="CopyClipboardChar"/>
                </group>
                <footer>
                    <button name="action_generate_link"
                            type="object"
                            string="Generate Link"
                            class="btn-primary"
                    />
                    <button string="Close"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>


    <odoo>
        <record id="action_reset_password_wizard" model="ir.actions.act_window">
            <field name="name">Reset Password (Manual)</field>
            <field name="res_model">reset.password.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
    </odoo>

</odoo>
