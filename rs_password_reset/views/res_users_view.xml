<odoo>
    <record id="view_users_form_reset_password_button" model="ir.ui.view">
        <field name="name">res.users.form.reset.password.button</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">

            <!-- Add button in header -->
            <xpath expr="//header" position="inside">
                <button
                        name="%(action_reset_password_wizard)d"
                        type="action"
                        string="Generate Reset Link"
                        class="btn-primary"
                        context="{'default_user_id': active_id}"
                        groups="base.group_system"/>
            </xpath>

        </field>
    </record>
</odoo>
