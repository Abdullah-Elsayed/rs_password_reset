    <!-- Also inherit reset password fields template if it exists -->
    <template id="reset_password_fields_inherit" inherit_id="auth_signup.fields" priority="20">
        <xpath expr="//input[@id='password']" position="after">
            <div class="password-strength-meter mt-2">
                <div class="strength-bar">
                    <div class="strength-bar-fill" id="strength-bar"/>
                </div>
                <div class="strength-text" id="strength-text"/>
                <div class="password-requirements mt-2">
                    <small>
                        <ul class="list-unstyled mb-0">
                            <li id="req-length">
                                <i class="fa fa-circle-o"/>
                                At least 8 characters
                            </li>
                            <li id="req-upper">
                                <i class="fa fa-circle-o"/>
                                One uppercase letter
                            </li>
                            <li id="req-lower">
                                <i class="fa fa-circle-o"/>
                                One lowercase letter
                            </li>
                            <li id="req-number">
                                <i class="fa fa-circle-o"/>
                                One number
                            </li>
                            <li id="req-special">
                                <i class="fa fa-circle-o"/>
                                One special character
                            </li>
                        </ul>
                    </small>
                </div>
            </div>
        </xpath>
        <xpath expr="//input[@id='confirm_password']" position="after">
            <div class="password-match-indicator mt-2" id="password-match-indicator" style="display:none;">
                <small>
                    <span id="match-message"/>
                </small>
            </div>
        </xpath>
    </template>
</odoo>

